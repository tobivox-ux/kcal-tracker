{
  "expo": {
    "name": "kcal-tracker",
    "slug": "kcal-tracker",
    "scheme": "kcaltracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Erlaube kcal-tracker den Zugriff auf deine Fotos, um Mahlzeiten per Foto zu erkennen.",
          "cameraPermission": "Erlaube kcal-tracker den Zugriff auf die Kamera, um Mahlzeiten zu fotografieren und automatisch zu erkennen."
        }
      ]
    ]
  }
}
